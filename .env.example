# ======================================================================
# .env ở GỐC dự án — hai nhóm cấu hình, copy thành `.env` rồi điền.
# Mỗi app vẫn có .env riêng: apps/api/.env, apps/admin/.env.
# ======================================================================

# ---- 1. Chạy bằng PM2 trên VPS (ecosystem.config.cjs, install.sh)
# Tiền tố tên tiến trình PM2: <prefix>-api, <prefix>-admin.
# Chạy nhiều bản CMSNT Panel trên cùng máy chủ thì mỗi thư mục đặt một prefix khác nhau.
PM2_APP_PREFIX=novai
# Cổng nội bộ của admin (chỉ nghe 127.0.0.1, nginx đứng trước).
# Cổng API đặt bằng PORT trong apps/api/.env (mặc định 4317).
ADMIN_PORT=3317

# ---- 2. Docker Compose production (docker-compose.prod.yml, copy thành .env.production)
POSTGRES_USER=cmsnt
POSTGRES_PASSWORD=doi-mat-khau-manh
POSTGRES_DB=novai
JWT_ACCESS_SECRET=chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
API_PUBLIC_URL=https://panel.shop.com
ADMIN_URL=https://panel.shop.com/admin
CORS_ORIGINS=https://panel.shop.com,https://shop.com
# Tuỳ chọn — chỉ khi có frontend riêng gọi API public: domain của frontend (link email,
# URL trả về sau thanh toán, nút "Xem trên website") và secret dùng chung để nhận
# webhook revalidate / gửi log lỗi.
# SITE_URL=https://shop.com
# REVALIDATE_SECRET=chuoi-ngau-nhien-khac
# Lưu trữ media trên S3/R2 (tuỳ chọn; mặc định local volume uploads)
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=1
