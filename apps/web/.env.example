# Website khách nov.ai.vn (apps/web) — chép thành .env.local rồi sửa. KHÔNG commit file .env thật.

# Địa chỉ API NestJS (apps/api) mà Next.js rewrite /api/* và /uploads/* tới (phía máy chủ Next, không lộ ra trình duyệt)
API_URL=http://localhost:4317

# Tên website hiển thị khi chưa tải được cấu hình từ API (bootstrap.settings.general.siteName)
NEXT_PUBLIC_SITE_NAME=NOV AI

# Mô tả ngắn cho thẻ meta / landing page
NEXT_PUBLIC_SITE_DESCRIPTION=Tạo video, ảnh, giọng đọc, âm nhạc bằng AI với các model hàng đầu — trả phí theo credits

# Địa chỉ công khai của website (dùng cho link giới thiệu, metadata). Bỏ trống thì lấy theo trình duyệt
NEXT_PUBLIC_SITE_URL=http://localhost:3318

# (tuỳ chọn) Trùng SERVER_API_SECRET của apps/api: server Next gửi kèm khi render trang để không bị giới hạn request
SERVER_API_SECRET=

# Địa chỉ trang quản trị (apps/admin) — nút "Quản trị" chỉ hiện với tài khoản có quyền admin.access. Bỏ trống = ẩn nút
NEXT_PUBLIC_ADMIN_URL=http://localhost:3317
