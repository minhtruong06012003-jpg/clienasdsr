# URL nội bộ của API (Next.js rewrite /api/* tới đây)
API_URL=http://localhost:4317
# URL website khách (apps/web) — nút "Trang khách" trên thanh trên cùng và các link "Xem trên web".
# Để trống = ẩn mọi link mở website. Production điền tên miền thật, vd: https://nov.ai.vn
NEXT_PUBLIC_WEB_URL=http://localhost:3318

# Domain cookie dùng chung với frontend riêng (production, vd: .shop.com) — để trống khi dev
NEXT_PUBLIC_COOKIE_DOMAIN=
