NODE_ENV=development
PORT=4317
# URL công khai của API (dùng để build đường dẫn media)
API_PUBLIC_URL=http://localhost:4317
DATABASE_URL=postgresql://cmsnt:cmsnt@localhost:5517/novai?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Khoá mã hoá kho mã số (key / tài khoản / thẻ bán cho khách), AES-256-GCM. Khuyên đặt chuỗi ngẫu nhiên riêng
# (vd `openssl rand -hex 32`) TRƯỚC khi nhập mã; bỏ trống = dẫn xuất từ JWT_ACCESS_SECRET (đổi JWT là mất mã cũ).
# Sao lưu khoá này cùng database — đổi / mất khoá thì mã đã nhập không giải mã được nữa.
DIGITAL_CODES_KEY=

# Các origin được phép gọi API kèm cookie (admin + frontend riêng của dự án nếu có, cách nhau dấu phẩy)
CORS_ORIGINS=http://localhost:3317

# Frontend riêng (TUỲ CHỌN — Panel không kèm website khách). Bỏ trống thì địa chỉ website lấy từ
# Cài đặt › Chung › Địa chỉ website; chưa có cả hai thì link email / xem trước / quay về sau thanh toán bị ẩn hoặc báo lỗi rõ.
# WEB_URL=https://shop.example.com
# URL nội bộ để API gọi frontend (revalidate, /api/capabilities) khi WEB_URL đi qua proxy mà máy chủ không gọi tới được
# WEB_INTERNAL_URL=http://127.0.0.1:3200
# Secret để API gọi <WEB_URL>/api/revalidate khi nội dung thay đổi; bỏ trống = không gửi gì (không báo lỗi)
# REVALIDATE_SECRET=chuoi-ngau-nhien
# URL trang quản trị (link đặt lại mật khẩu admin)
ADMIN_URL=http://localhost:3317

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=20

# Lưu trữ media: local (thư mục UPLOAD_DIR) | s3 (AWS S3, Cloudflare R2, MinIO...)
STORAGE_DRIVER=local
# S3_BUCKET=cmsnt-media
# S3_REGION=auto                         # AWS: ap-southeast-1...; R2/MinIO: auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # bỏ trống nếu dùng AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.shop.com     # URL công khai (custom domain / CDN) của bucket
# S3_FORCE_PATH_STYLE=1                  # MinIO / R2: 1; AWS S3 virtual-host: 0

# Sao lưu database (Công cụ › Sao lưu). Mặc định dùng pg_dump/psql trong PATH theo DATABASE_URL.
# BACKUP_DIR=backups                     # mặc định: thư mục "backups" cạnh thư mục uploads
# Khi API không có pg_dump (vd dev dùng PostgreSQL trong docker) -> lệnh in SQL ra stdout / đọc SQL từ stdin:
# BACKUP_CMD="docker exec novai-postgres pg_dump -U cmsnt -d novai --no-owner --no-privileges --clean --if-exists"
# BACKUP_RESTORE_CMD="docker exec -i novai-postgres psql -U cmsnt -d novai -X -q -v ON_ERROR_STOP=1"

# Tài khoản admin mặc định khi seed
SEED_ADMIN_EMAIL=admin@cmsnt.co
SEED_ADMIN_PASSWORD=123456

# Tin X-Forwarded-For từ đâu: loopback (mặc định) | 1 (sau 1 reverse proxy) | danh sách IP
TRUST_PROXY=loopback

# Giới hạn request toàn cục mỗi IP: THROTTLE_LIMIT request trong THROTTLE_TTL giây (mặc định 300 / 60).
# Các route nhạy cảm (đăng nhập, đăng ký, tra cứu đơn...) có giới hạn riêng chặt hơn, không đổi theo biến này.
# THROTTLE_LIMIT=300
# THROTTLE_TTL=60
# Bí mật cho máy chủ frontend SSR (gửi header `x-server-secret`): được miễn giới hạn toàn cục để một IP máy chủ
# không bị 429; giới hạn riêng của từng route vẫn tính theo IP thật của khách gửi trong header `x-client-ip`.
# Request mang API key hợp lệ cũng được miễn giới hạn toàn cục. Bỏ trống = tắt. Tạo bằng `openssl rand -hex 32`.
# SERVER_API_SECRET=

# Dung lượng body JSON tối đa: mặc định 1mb; riêng /api/admin/* (nhập liệu, khôi phục, Page Builder) 10mb
# BODY_LIMIT=1mb
# ADMIN_BODY_LIMIT=10mb

# Tài liệu API Swagger (/api/docs, /api/docs/admin): luôn bật khi dev; production chỉ bật khi đặt true
# SWAGGER_ENABLED=false

# Cache-Control cho GET /api/public/* của khách vãng lai: s-maxage (giây) cho CDN/proxy; 0 = không cho cache dùng chung
# PUBLIC_CACHE_SMAXAGE=60

# Thời gian giữ cache cài đặt trong bộ nhớ (giây). Chạy nhiều instance API: thay đổi ở instance này
# hiện ở instance khác sau tối đa chừng ấy giây. 0 = luôn đọc DB.
# SETTINGS_CACHE_TTL=30

# Thống kê truy cập (Báo cáo › Truy cập)
# Header quốc gia do CDN gắn, chỉ đặt khi API thực sự đứng sau CDN đó (vd cf-ipcountry với Cloudflare). Để trống = không ghi quốc gia
ANALYTICS_COUNTRY_HEADER=
# Bí mật băm mã khách ẩn danh (mặc định dùng JWT_ACCESS_SECRET)
ANALYTICS_SALT=

# Nhật ký lỗi (Hệ thống › Nhật ký lỗi): thư mục file log và mức ghi mặc định (error|warn|info|debug)
# LOG_DIR=logs
# LOG_LEVEL=warn

# Bot Telegram (Admin › Cài đặt › Bot Telegram): đặt false ở máy dev nếu dùng chung bot với production —
# Telegram chỉ cho một nơi nhận lệnh (getUpdates) mỗi bot; tắt thì vẫn gửi được thông báo nhưng bot không trả lời lệnh.
TELEGRAM_POLLING=true
